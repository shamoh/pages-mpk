---
// The animated background of the hero: particles on elliptic orbits around the pointer (or the centre on a phone).
// Drawn on a canvas, paused when the hero is off screen; a still frame when the system asks for reduced motion.
---

<canvas class="orbits" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.orbits')!;
  const ctx = canvas.getContext('2d')!;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const colors = ['#4de3ff', '#9b7bff', '#ff7ad9', '#c6ff4d'];
  let width = 0;
  let height = 0;
  let centre = { x: 0, y: 0 };
  let target = { x: 0, y: 0 };
  let visible = true;

  type Particle = { a: number; b: number; tilt: number; speed: number; phase: number; size: number; color: string };
  let particles: Particle[] = [];

  function resize() {
    const ratio = Math.min(devicePixelRatio || 1, 2);
    width = canvas.clientWidth;
    height = canvas.clientHeight;
    canvas.width = width * ratio;
    canvas.height = height * ratio;
    ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
    centre = target = { x: width * 0.72, y: height * 0.45 };
    const count = width < 640 ? 70 : 140;
    const radius = Math.min(width, height) * 0.55;
    particles = Array.from({ length: count }, (_, i) => ({
      a: radius * (0.25 + Math.random() * 0.9),
      b: radius * (0.08 + Math.random() * 0.3),
      tilt: (i % 3) * (Math.PI / 3) + Math.random() * 0.2,
      speed: (0.15 + Math.random() * 0.35) * (Math.random() < 0.5 ? 1 : -1),
      phase: Math.random() * Math.PI * 2,
      size: Math.random() * 1.8 + 0.4,
      color: colors[i % colors.length],
    }));
  }

  function draw(time: number) {
    centre.x += (target.x - centre.x) * 0.04;
    centre.y += (target.y - centre.y) * 0.04;
    ctx.clearRect(0, 0, width, height);
    for (const p of particles) {
      const t = p.phase + (time / 1000) * p.speed;
      const x = p.a * Math.cos(t);
      const y = p.b * Math.sin(t);
      const px = centre.x + x * Math.cos(p.tilt) - y * Math.sin(p.tilt);
      const py = centre.y + x * Math.sin(p.tilt) + y * Math.cos(p.tilt);
      ctx.globalAlpha = 0.35 + 0.65 * ((Math.sin(t) + 1) / 2);
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(px, py, p.size, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
    const glow = ctx.createRadialGradient(centre.x, centre.y, 0, centre.x, centre.y, 26);
    glow.addColorStop(0, 'rgba(198,255,77,0.9)');
    glow.addColorStop(1, 'rgba(198,255,77,0)');
    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.arc(centre.x, centre.y, 26, 0, Math.PI * 2);
    ctx.fill();
    if (!still && visible) requestAnimationFrame(draw);
  }

  resize();
  addEventListener('resize', resize);
  addEventListener('pointermove', (event) => {
    const box = canvas.getBoundingClientRect();
    if (event.pointerType === 'mouse') target = { x: event.clientX - box.left, y: event.clientY - box.top };
  });
  new IntersectionObserver(([entry]) => {
    const was = visible;
    visible = entry.isIntersecting;
    if (visible && !was && !still) requestAnimationFrame(draw);
  }).observe(canvas);
  requestAnimationFrame(draw);
</script>

<style>
  .orbits {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
</style>
